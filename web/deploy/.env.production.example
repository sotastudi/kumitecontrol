# Plantilla del .env en el servidor.
# NO subir este archivo con secretos; crear el remoto a mano o por SSH.
# El deploy protege .env remoto (no lo sobrescribe).
#
# Importante: NO uses DB_SOCKET (eso es solo MAMP local).

APP_NAME=KumiteControl
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com/app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# file hasta tener tablas migradas; luego puedes volver a database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/app
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# SMTP del hosting. MAIL_SCHEME solo admite smtp o smtps (465 = smtps; 587 = smtp con STARTTLS).
# Valores como tls o https hacen fallar el envío. Una sola línea MAIL_SCHEME en el .env.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ADULT_AGE=18
